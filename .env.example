APP_NAME=Exam Audio Relay

# Database (matches docker-compose service name "db")
DATABASE_URL=postgresql+psycopg://exam:exam_password@db:5432/exam_audio
POSTGRES_USER=exam
POSTGRES_PASSWORD=exam_password
POSTGRES_DB=exam_audio

# Initial superadmin bootstrap (created on first start if missing)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_me_now
INITIAL_ADMIN_EMAIL=

# Storage
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=250

# Network
HOST=0.0.0.0
PORT=8080

# Security: change SECRET_KEY in production. Use:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace_me_with_a_long_random_string
SESSION_COOKIE_SECURE=false

# Optional public URL used to render full session links (e.g. Tailscale Funnel hostname)
BASE_URL=

# Timezone
TZ=Europe/Rome
